# Backend configuration. Copy to .env and fill credentials locally.
# Never put credentials in frontend variables.

# Database connection
MONGODB_URI=
MONGODB_DB=membrane
WORKSPACE_ID=membrane-demo-v2
GOVERNED_MEMORY_ENABLED=true

# DeepSeek: decisions and image extraction (same API key)
LLM_PROVIDER=deepseek
VISION_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-flash
VISION_MODEL=deepseek-flash

# Voyage: vector embeddings (separate API key)
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMENSIONS=1024

# Local testing limits
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_OUTPUT_TOKENS=1200
MAX_RUN_MODEL_CALLS=80
MAX_CONCURRENT_MODEL_CALLS=2
WORKER_ENABLED=true
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Optional: leave disabled for the first test
VOICE_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Optional: import selected emails from Gmail as untrusted sources. See docs/gmail-setup.md.
# Simplest: a Gmail app password (needs 2-Step Verification). The app only ever reads.
GMAIL_ENABLED=false
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Alternative with a read-only grant: Google OAuth "Desktop app" client + python -m scripts.gmail_authorize
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
