# MongoDB Atlas Sandbox (hackathon project). Never commit the real .env.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.x7bcoi.mongodb.net/?retryWrites=true&w=majority
DB_NAME=membrane

# Legacy static demo only: set LLM_PROVIDER=anthropic or openai in a separate config.
# The integrated review API below uses DeepSeek by default.
LLM_API_KEY=
# Optional. Defaults: claude-sonnet-5-5 (anthropic), gpt-4o-mini (openai).
LLM_MODEL=
# Optional. Set to "none" if your model rejects the temperature parameter.
LLM_TEMPERATURE=0

# New v1 review API: uvicorn backend.app.main:app --host 127.0.0.1 --port 8000
# API keys belong only in a local ignored .env. Do not paste them into chat.
# MONGODB_URI above is shared; replace its placeholders locally.
MONGODB_DB=membrane
WORKSPACE_ID=membrane-demo-v2
GOVERNED_MEMORY_ENABLED=true
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
VISION_PROVIDER=deepseek
OPENAI_API_KEY=
AGENT_MODEL=deepseek-flash
VISION_MODEL=deepseek-flash
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMENSIONS=1024
MODEL_TIMEOUT_SECONDS=45
MAX_AGENT_TURNS=3
MAX_RUN_MODEL_CALLS=80
MAX_CONCURRENT_MODEL_CALLS=2
# Omit temperature for models that do not support it.
# MODEL_TEMPERATURE=0
MODEL_MAX_OUTPUT_TOKENS=1200
WORKER_ENABLED=true
LEASE_SECONDS=180
FRONTEND_ORIGIN=http://127.0.0.1:5173
VOICE_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=
MAX_TTS_CHARACTERS_PER_REQUEST=2000
MAX_TTS_CHARACTERS_TOTAL=20000
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
